<?xml version="1.0" encoding="UTF-8"?>
<suite parallel="tests" thread-count="2" name="OpenCart Test Suite">
<listeners>
   <listener class-name="listeners.ExtentReportManager"/>
   <listener class-name="listeners.ScreenshotListener"/>
</listeners>

   <test name="chromeTests">
      <parameter name="browser" value="chrome"/>
      <classes>
         <class name="tests.RegistrationTest"/>
      </classes>
   </test>
  
   <test name="EdgeTests">
      <parameter name="browser" value="edge"/>
      <classes>
         <class name="tests.RegistrationTest"/>
      </classes>
   </test>
   
   <test name="FirefoxTests">
      <parameter name="browser" value="firefox"/>
      <classes>               
         <class name="tests.RegistrationTest"/>
      </classes>
   </test>
   
</suite>