<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="OpenCart TestSuite" thread-count="2" parallel="tests">  

<listeners>
   <listener class-name="listeners.ExtentReportManager"/>
   <listener class-name="listeners.ScreenshotListener"/>
</listeners>

   <test name="OpenCart Tests">
      <parameter name="browser" value="chrome"/>
      <classes>
         <class name="tests.RegistrationTest"/>
         <class name="tests.LoginTest"/>
      </classes>
   </test>
      
</suite>	  
